# Copy to .env.local (not committed) to point the app at a portal running on your PC.
# Use your PC LAN address as the phone sees it, not localhost.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

# Policy pages default to <API_URL>/privacy and /terms; override only if hosted elsewhere.
# The App Store link is for the forced-upgrade screen.
# EXPO_PUBLIC_PRIVACY_URL=https://www.agrograinhub.bg/privacy
# EXPO_PUBLIC_TERMS_URL=https://www.agrograinhub.bg/terms
# EXPO_PUBLIC_IOS_STORE_URL=https://apps.apple.com/app/id0000000000

# Google sign-in (Google Cloud → Credentials). The button stays hidden until these are set.
# The web client id is the ID-token audience; add it to GOOGLE_CLIENT_IDS on the portal.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234-abc.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=1234-xyz.apps.googleusercontent.com
