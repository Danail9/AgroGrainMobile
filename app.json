{
  "expo": {
    "name": "AgroGrain",
    "slug": "agromobile",
    "scheme": "agrograin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f3f5f2",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "bg.agrograin.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSpeechRecognitionUsageDescription": "AgroGrain използва разпознаване на реч, за да превърне гласа ти в текст.",
        "NSMicrophoneUsageDescription": "AgroGrain използва микрофона, за да можеш да задаваш въпроси с глас."
      },
      "associatedDomains": [
        "applinks:www.agrograinhub.bg"
      ],
      "usesAppleSignIn": true
    },
    "android": {
      "package": "bg.agrograin.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.agrograinhub.bg",
              "pathPrefix": "/reset-password"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "./plugins/withIosScene",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "AgroGrain използва Face ID, за да отключиш приложението сигурно."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-asset",
      "expo-notifications",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "AgroGrain използва микрофона, за да можеш да задаваш въпроси с глас.",
          "speechRecognitionPermission": "AgroGrain използва разпознаване на реч, за да превърне гласа ти в текст."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": false
        }
      ],
      "expo-apple-authentication"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6ac3fbd7-5d7e-487e-8adb-d0eeabc0272c"
      }
    },
    "owner": "danail-minchev"
  }
}
